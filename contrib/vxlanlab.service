[Unit]
Description=vxlanlab simulated VXLAN fabric (sFlow and SNMP for the local Kentik Universal Agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vxlanlab
ExecStartPre=/usr/bin/python3 -m vxlanlab aliases --apply
ExecStart=/usr/bin/python3 -m vxlanlab run --collector 127.0.0.1 --port 9995 --snmp --no-console --report 60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
